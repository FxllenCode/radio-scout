# Radio-Scout — environment configuration.
#
# Copy to `.env` (gitignored) and edit. Both the binary and the synthetic
# recorder (`cargo run --example feed`) read it, so a live test needs no
# copy-pasted key.
#
# The environment is the *middle* layer of configuration (ADR-0012): a CLI flag
# beats a variable, a variable beats `radio-scout.toml`, and that beats the
# default. Run `radio-scout --write-config` for a commented file with every
# setting in it — that is the better home for anything but the API key and a
# container's secrets.

# The ingest API key recorders authenticate with (ADR-0008). This **seeds an
# empty key roster** — a first run, or a wiped database — and then stands aside:
# keys are managed in Settings -> Admin -> API keys (#49), so one you revoke
# there does not come back on the next boot. With this unset (or blank), the
# first run generates a random one and writes it back into your `.env` — it is
# never logged (ADR-0011), so `cat .env` is how you read it. Any high-entropy
# string works:
#   openssl rand -hex 16
# It lives here rather than in radio-scout.toml because first run *writes* it.
RADIO_SCOUT_API_KEY=change-me-to-something-random

# The admin password (ADR-0008, #19). Gates everything under /api/admin/. Like
# the ingest key it lives here because first run *writes* it: with this unset,
# the first run generates a random one and puts it in your `.env`, and it is
# never logged — `cat .env` is how you read it. Radio-Scout deliberately has no
# default password to leave unchanged. If it cannot be written, no password is
# set and the admin surface stays shut.
#   openssl rand -hex 16
# RADIO_SCOUT_ADMIN_PASSWORD=

# How admin sessions and the brute-force lockout behave (#19). These also have
# TOML keys under [admin] — `radio-scout --write-config` documents them. The
# session's idle window is refreshed by use; its lifetime is not.
#
# Terminating TLS at a reverse proxy? Set RADIO_SCOUT_TRUSTED_PROXIES to it as
# well: the session cookie is marked Secure only when a *trusted* proxy reports
# X-Forwarded-Proto: https, so an unlisted proxy leaves the cookie replayable
# over plain http:// to the same host.
# RADIO_SCOUT_ADMIN_SESSION_IDLE_SECS=28800
# RADIO_SCOUT_ADMIN_SESSION_MAX_SECS=604800
# RADIO_SCOUT_ADMIN_LOCKOUT_ATTEMPTS=5
# RADIO_SCOUT_ADMIN_LOCKOUT_SECS=900

# Where the SQLite database and audio objects live. The live-test loop overrides
# this to ./radio-scout-live-test, which it wipes each run.
# RADIO_SCOUT_BASE_DIR=./radio-scout-data

# HTTP port for the API, the SPA and the live-feed WebSocket (all one origin).
# RADIO_SCOUT_PORT=3000

# Which configuration file to read (same as `--config`). Unset looks for
# radio-scout.toml in the working directory.
# RADIO_SCOUT_CONFIG=/etc/radio-scout.toml

# Database (ADR-0003). Unset means SQLite under the base directory.
# RADIO_SCOUT_DATABASE_URL=postgres://user:password@host/radio_scout

# Audio storage (ADR-0002): "filesystem" (default) or "s3". S3 credentials are
# read from the environment as well as the file, because that is where a
# container keeps them.
# RADIO_SCOUT_STORAGE_BACKEND=s3
# RADIO_SCOUT_STORAGE_PATH=/mnt/usb/radio-scout-audio
# RADIO_SCOUT_S3_BUCKET=calls
# RADIO_SCOUT_S3_REGION=garage
# RADIO_SCOUT_S3_ENDPOINT=http://garage.lan:3900
# RADIO_SCOUT_S3_ACCESS_KEY_ID=
# RADIO_SCOUT_S3_SECRET_ACCESS_KEY=
# RADIO_SCOUT_S3_ALLOW_HTTP=true

# Retention (#10): age window in days (0 = keep forever), an optional cap on
# total stored audio, and how the sweeper paces itself. Stored log events (#30)
# have a window of their own, so keeping Calls forever does not mean an
# unbounded logs table.
# RADIO_SCOUT_RETENTION_DAYS=7
# RADIO_SCOUT_RETENTION_MAX_SIZE_GB=10
# RADIO_SCOUT_RETENTION_LOG_DAYS=30
# RADIO_SCOUT_RETENTION_INTERVAL_SECS=3600
# RADIO_SCOUT_RETENTION_BATCH_SIZE=500
# RADIO_SCOUT_RETENTION_ORPHAN_GRACE_SECS=3600

# Ingest (#5, #8): the duplicate-detection window (0 disables it) and whether
# unknown Systems/Talkgroups/Units are created on arrival.
# RADIO_SCOUT_INGEST_DEDUP_WINDOW_MS=500
# RADIO_SCOUT_INGEST_AUTO_POPULATE=true

# Keep-best dedup (#46): what counts as one transmission arriving twice, and
# which copy is kept. "patched" also matches a copy whose patch membership
# overlaps, so a console patch uploaded once per member Talkgroup is one Call;
# "best" keeps the cleaner, longer copy, replacing the stored one without
# changing its id. Set these to "talkgroup" and "first" for rdio-scanner's
# behaviour. The third is how long a stored call stays open to a better copy —
# upload separation, not transmission separation, which is why it is its own
# number and measured in seconds.
# RADIO_SCOUT_INGEST_DEDUP_SCOPE=patched
# RADIO_SCOUT_INGEST_DEDUP_KEEP=best
# RADIO_SCOUT_INGEST_DEDUP_REPLACE_SECS=30

# Behind a reverse proxy or Docker's bridge: whose X-Forwarded-For the request
# log may believe. Empty (the default) believes nobody.
# RADIO_SCOUT_TRUSTED_PROXIES=127.0.0.1,172.17.0.0/16

# Where this scanner can be reached from outside — used to build the audio link
# in a Webhook's payload. Unset (the default), a webhook still carries every
# fact about the Call and simply has no link: a guessed URL in somebody's chat
# room is worse than none.
# RADIO_SCOUT_PUBLIC_URL=https://scanner.example

# Audio enhancement (#20, ADR-0006): reprocess each Call's audio after it is
# stored so it is clearer and levelled between Talkgroups. Off by default, and
# never on the ingest path. "normalize" is band-pass + EBU R128 loudness;
# "denoise" adds RNNoise on top and is unproven on digital (P25/DMR) audio.
# Output is 8 kHz mono WAV; "opus" parses but refuses to boot until #100.
# RADIO_SCOUT_ENHANCEMENT_MODE=off
# RADIO_SCOUT_ENHANCEMENT_OUTPUT=wav
# RADIO_SCOUT_ENHANCEMENT_TARGET_LUFS=-16.0
# RADIO_SCOUT_ENHANCEMENT_QUEUE_DEPTH=512

# Mining the archive you already had (#48). SDRTrunk buries the radio aliases
# and tower names you configured in it inside every MP3 it uploads, and its
# upload API has no field for any of them. New Calls are mined as they arrive
# whatever this says; the sweep is what goes back over the rest. Turn it off if
# your audio lives on metered object storage.
# RADIO_SCOUT_MINING_SWEEP=false
# RADIO_SCOUT_MINING_INTERVAL_SECS=300
# RADIO_SCOUT_MINING_BATCH_SIZE=25

# Forwarding Calls on to other rdio-compatible instances (#52). The peers
# themselves live in Settings -> Downstreams, not here — this is only how hard
# we try. Nothing is lost when a peer goes down: matching Calls are queued as
# they are stored and drained in order once it comes back, across a restart of
# either end. The retry wait doubles from the first value up to the second.
# RADIO_SCOUT_DOWNSTREAM_TIMEOUT_SECS=60
# RADIO_SCOUT_DOWNSTREAM_RETRY_INITIAL_SECS=10
# RADIO_SCOUT_DOWNSTREAM_RETRY_MAX_SECS=600

# Posting marked Calls to your own URLs (#54) — a Discord channel, or whatever
# your automation listens on. The webhooks themselves live in Settings ->
# Webhooks, not here: a webhook URL is a credential (a Discord one ends in a
# token), so it is kept in the database, never shown again, and never logged.
# This is only how hard we try. The timeout is shorter than a downstream's on
# purpose — a few hundred bytes of JSON, not a minute of audio.
# RADIO_SCOUT_WEBHOOK_TIMEOUT_SECS=10
# RADIO_SCOUT_WEBHOOK_RETRY_INITIAL_SECS=5
# RADIO_SCOUT_WEBHOOK_RETRY_MAX_SECS=60

# Log filter (ADR-0011). Overrides `[log] directives` for a single run.
# RUST_LOG=debug

# What the Settings -> Logs view keeps (#30): "off", "error", "warn" or "info".
# Independent of the console filter above. There is deliberately no "debug" —
# those lines can carry a listener's IP address, and a public instance must not
# accumulate a database of who listened and when.
# RADIO_SCOUT_LOG_DATABASE_LEVEL=info
